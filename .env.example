# Copia este archivo como .env para personalizar la ejecución
BASE_URL=https://www.saucedemo.com
BROWSER=chromium        # chromium | firefox | webkit
HEADLESS=true           # false para ver el navegador
SLOW_MO=0               # ms de pausa entre acciones (útil para demos)
STEP_TIMEOUT=30000      # timeout por step en ms
PARALLEL=2              # workers en paralelo
SAUCE_PASSWORD=secret_sauce
